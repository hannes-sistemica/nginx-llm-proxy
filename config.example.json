{
  "admin_password": "change-me",
  "api_keys": {
    "default": "sk-change-me"
  },
  "health_check_interval": 30,
  "default_max_concurrent": 1000000,
  "sticky_ttl": 600,

  "models": {
    "llama3": {
      "backend": "127.0.0.1:8080",
      "description": "Llama 3 70B (Q4_K_M) — legacy single-backend form"
    },

    "qwen-27b": {
      "description": "Multi-backend, health-based failover + capacity-aware. Backends tried in order; skip any 'down'; pick the first healthy one under its max_concurrent; if all saturated, use the least-loaded. First entry = preferred.",
      "backend_model": "qwen-27b",
      "backends": [
        { "name": "gpu-fast",  "url": "127.0.0.1:8082", "max_concurrent": 2 },
        { "name": "cpu-slow",  "url": "127.0.0.1:8083" }
      ]
    },

    "embed": {
      "backend": "127.0.0.1:8084",
      "description": "Nomic Embed Text v1.5 (F16)"
    }
  }
}
